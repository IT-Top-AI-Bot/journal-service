# syntax=docker/dockerfile:1.7
# Packaging-only Dockerfile: expects pre-built native binary in build context as ./journal-service
# Used by CI (native compilation happens on the runner with Gradle cache, not inside Docker)

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /application

COPY journal-service /application/app

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/application/app"]
